# SouqSmart FastAPI service environment configuration
# Copy this file to `.env` and replace the placeholder values.
# Never commit `.env` — it contains secrets. `.env` is excluded by .gitignore.

# --- Application environment ---
SOUQSMART_SERVICE_KEY=replace-with-a-secure-random-shared-key
SOUQSMART_CATALOG_PROVIDER=php
SOUQSMART_PHP_BASE_URL=http://127.0.0.1/nice-shop

# --- Catalog / session tuning ---
SOUQSMART_CATALOG_TIMEOUT_SECONDS=3
SOUQSMART_SESSION_TTL_SECONDS=1800
SOUQSMART_SESSION_TURN_LIMIT=20

# --- Uvicorn bind (documented defaults; pass --host/--port explicitly on startup) ---
SOUQSMART_HOST=127.0.0.1
SOUQSMART_PORT=8000

# --- Intent parser ---
# Keep SOUQSMART_INTENT_PARSER=deterministic by default; set to "llm" to enable Gemini.
SOUQSMART_INTENT_PARSER=deterministic

# --- Gemini LLM (optional, used only when SOUQSMART_INTENT_PARSER=llm) ---
# Accepted names: GEMINI_API_KEY or SOUQSMART_GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
# Accepted names: GEMINI_MODEL or SOUQSMART_GEMINI_MODEL
GEMINI_MODEL=gemini-3.8-flash
# Accepted names: GEMINI_TIMEOUT_SECONDS or SOUQSMART_GEMINI_TIMEOUT_SECONDS
GEMINI_TIMEOUT_SECONDS=3.5
