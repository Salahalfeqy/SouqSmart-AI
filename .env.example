# SouqSmart FastAPI service environment configuration
# Copy this file to `.env` and replace the placeholder values.
# Never commit `.env` — it contains secrets. `.env` is excluded by .gitignore.

# --- Application environment ---
SOUQSMART_SERVICE_KEY=replace-with-a-secure-random-shared-key
SOUQSMART_CATALOG_PROVIDER=php
SOUQSMART_PHP_BASE_URL=http://127.0.0.1/nice-shop

# --- Catalog / session tuning ---
SOUQSMART_CATALOG_TIMEOUT_SECONDS=3
SOUQSMART_SESSION_TTL_SECONDS=1800
SOUQSMART_SESSION_TURN_LIMIT=20

# --- SQLite Database Conversation Persistence ---
SOUQSMART_SESSION_STORE=database
SOUQSMART_DATABASE_PATH=data/souqsmart_chat.db

# --- Uvicorn bind (documented defaults; pass --host/--port explicitly on startup) ---
SOUQSMART_HOST=127.0.0.1
SOUQSMART_PORT=8000

# --- Intent parser ---
# Keep SOUQSMART_INTENT_PARSER=deterministic by default; set to "llm" to enable Gemini.
SOUQSMART_INTENT_PARSER=deterministic

# --- Gemini LLM (Query Rewriting & Response Generation) ---
# Accepted names: GEMINI_API_KEY or SOUQSMART_GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
# Accepted names: GEMINI_MODEL or SOUQSMART_GEMINI_MODEL
GEMINI_MODEL=gemini-2.5-flash
# Accepted names: GEMINI_TIMEOUT_SECONDS or SOUQSMART_GEMINI_TIMEOUT_SECONDS
GEMINI_TIMEOUT_SECONDS=3.5

# --- Conversational Query Rewriter ---
SOUQSMART_QUERY_REWRITER_ENABLED=true
SOUQSMART_REWRITER_MODEL=gemini-2.5-flash
SOUQSMART_REWRITER_TIMEOUT_SECONDS=3.0

# --- Gemini Embeddings API ---
SOUQSMART_GEMINI_EMBEDDING_API_KEY=your_gemini_embedding_api_key_here
SOUQSMART_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
SOUQSMART_GEMINI_EMBEDDING_DIM=768
SOUQSMART_GEMINI_EMBEDDING_TIMEOUT_SECONDS=5.0

# --- Qdrant Vector Database ---
SOUQSMART_QDRANT_HOST=localhost
SOUQSMART_QDRANT_PORT=6333
SOUQSMART_QDRANT_HTTPS=false
SOUQSMART_QDRANT_API_KEY=
SOUQSMART_QDRANT_COLLECTION_PRODUCTS=products_v1
SOUQSMART_QDRANT_COLLECTION_KNOWLEDGE=knowledge_chunks_v1

# --- RAG Hybrid Retrieval & Ingestion ---
SOUQSMART_RAG_HYBRID_ENABLED=true
SOUQSMART_RAG_KNOWLEDGE_ENABLED=true
SOUQSMART_RAG_INGESTION_BATCH_SIZE=50
